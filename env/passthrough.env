# Credentials and switches forwarded from the host shell into the agent container.
#
# A bare NAME (no "=") copies the value from the shell that runs `docker compose`,
# and is skipped when the shell does not define it. This file is listed last in
# base-compose.yml, so the effective precedence is:
#
#   host shell  >  <project>/.agentic-devbox/secrets.env  >  ~/.config/agentic-devbox/secrets.env
#
# Put long-lived values in one of the secrets.env files (chmod 600) and use the shell
# for one-off overrides. To support a new variable, add its name here.

# Anthropic: Claude Code (API key, or a long-lived token from `claude setup-token`)
ANTHROPIC_API_KEY
CLAUDE_CODE_OAUTH_TOKEN

# Google: Antigravity CLI (agy) with "modelProvider": "gemini"
GEMINI_API_KEY

# GitHub: Copilot CLI (fine-grained PAT with the "Copilot Requests" permission) and gh
COPILOT_GITHUB_TOKEN
GH_TOKEN

# OpenAI: Codex CLI, and OpenCode with OpenAI models
OPENAI_API_KEY

# OpenCode with other providers
OPENROUTER_API_KEY

# agentic-devbox switches
AGENTIC_DEVBOX_CDP_EXPOSE
AGENTIC_DEVBOX_BROWSER
AGENTIC_DEVBOX_VSCODE_WEB
